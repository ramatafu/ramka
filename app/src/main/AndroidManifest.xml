<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Интернет-режим (этап 4) и LAN-сокеты -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Сканирование QR -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Проверка состояния сети перед попыткой соединения -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Обнаружение в локальной сети -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- MulticastLock для mDNS (NSD): без него часть прошивок отбрасывает multicast-пакеты на Wi-Fi -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Уведомления о новых сообщениях (опционально, запрашивается по месту) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Короткая вибрация при активации экстренного сброса -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Фоновая доставка (опционально, этап 2+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: разрешение под тип foreground-сервиса specialUse (см. <service> ниже и DEVIATIONS.md, «ЭТАП B.8») -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Звонки (шаг 7.3): микрофон — runtime-разрешение, запрашивается на экране звонка. CAMERA (выше) — для видео (7.4). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth-гарнитура: до API 30 хватает BLUETOOTH, с API 31 для маршрутизации звука нужен BLUETOOTH_CONNECT (runtime). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".RamkaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ramka"
        android:theme="@style/Theme.Ramka"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ramka"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider (этап 6.4): отдаёт другим приложениям файлы из чата при открытии по ACTION_VIEW.
            Не экспортируется; права выдаются только на конкретный Uri и только на чтение
            (FLAG_GRANT_READ_URI_PERMISSION). Доступные каталоги перечислены в res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Постоянный сервис доставки (опциональный, по умолчанию ВЫКЛ — под-тумблер в настройках).
            Тип specialUse выбран осознанно: dataSync на Android 15 ограничен 6 часами из 24 и
            принудительно останавливается, что для сервиса "держать процесс живым" не подходит;
            connectedDevice предназначен для внешних устройств (Bluetooth/NFC/IR/USB), а не для
            приёма по локальной сети. У specialUse лимита по времени нет; обоснование обязательно
            и дано в property ниже. Приложение распространяется только через GitHub, поэтому
            Play-декларация не требуется.
        -->
        <service
            android:name=".background.PersistentDeliveryService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Peer-to-peer messenger without a server: keeps the app process alive so the local-network message receiver and mDNS discovery keep working under OEM background restrictions. The user enables it explicitly; it processes no data itself." />
        </service>

        <!--
            Сканер QR. Встроенная CaptureActivity библиотеки заперта в sensorLandscape, поэтому используем
            свою (PortraitCaptureActivity): fullUser — вертикально и горизонтально, по положению телефона и
            блокировке поворота. Тема — штатная полноэкранная тема библиотеки.
        -->
        <activity
            android:name=".ui.qr.PortraitCaptureActivity"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Кнопка «Отклонить» в уведомлении о входящем звонке. Не экспортируется. -->
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

    </application>
</manifest>
