diff --git a/app/src/main/res/drawable/ic_launcher_foreground.xml b/app/src/main/res/drawable/ic_launcher_foreground.xml
new file mode 100644
index 0000000..96c381d
--- /dev/null
+++ b/app/src/main/res/drawable/ic_launcher_foreground.xml
@@ -0,0 +1,26 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Передний план адаптивной иконки (108x108dp). Логотип занимает 44dp по центру: помещается в безопасную
+    зону (круг 66dp), поэтому не обрезается ни одной маской. Размеры штрихов сняты с исходного PNG.
+    Этот же слой используется как monochrome (тематические иконки Android 13+) и как иконка заставки Android 12+.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+    <path
+        android:pathData="M33.12,33.12 L74.88,33.12 L74.88,74.88 L33.12,74.88 Z"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="2.24"
+        android:strokeLineJoin="round" />
+    <path
+        android:pathData="M40.86,40.86 L67.14,40.86 L67.14,67.14 L40.86,67.14 Z"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="2.1"
+        android:strokeLineJoin="miter" />
+    <path
+        android:pathData="M33.12,33.12 L40.86,40.86 M74.88,33.12 L67.14,40.86 M74.88,74.88 L67.14,67.14 M33.12,74.88 L40.86,67.14"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="2.1" />
+</vector>
diff --git a/app/src/main/res/drawable/ic_ramka_logo.xml b/app/src/main/res/drawable/ic_ramka_logo.xml
new file mode 100644
index 0000000..3fdbb3b
--- /dev/null
+++ b/app/src/main/res/drawable/ic_ramka_logo.xml
@@ -0,0 +1,29 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Логотип ramka (рамка с внутренним квадратом и четырьмя диагоналями), 24dp, одноцветный.
+    Используется как маленькая иконка уведомлений (система красит её сама) и в интерфейсе
+    (Icon(...) красит tint-ом). Линии чуть толще, чем в исходном PNG, чтобы читались в статус-баре.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24">
+    <!-- внешняя рамка -->
+    <path
+        android:pathData="M2.3,2.3 L21.7,2.3 L21.7,21.7 L2.3,21.7 Z"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="1.6"
+        android:strokeLineJoin="round" />
+    <!-- внутренний квадрат -->
+    <path
+        android:pathData="M5.9,5.9 L18.1,5.9 L18.1,18.1 L5.9,18.1 Z"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="1.5"
+        android:strokeLineJoin="miter" />
+    <!-- диагонали -->
+    <path
+        android:pathData="M2.3,2.3 L5.9,5.9 M21.7,2.3 L18.1,5.9 M21.7,21.7 L18.1,18.1 M2.3,21.7 L5.9,18.1"
+        android:strokeColor="#FFFFFF"
+        android:strokeWidth="1.5" />
+</vector>
