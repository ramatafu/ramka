diff -uNr a/app/src/main/java/com/ramka/app/discovery/LanPresenceCoordinator.kt b/app/src/main/java/com/ramka/app/discovery/LanPresenceCoordinator.kt
--- a/app/src/main/java/com/ramka/app/discovery/LanPresenceCoordinator.kt	1970-01-01 00:00:00.000000000 +0000
